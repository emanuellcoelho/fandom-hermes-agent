#!/bin/sh
# Report this agent's token usage to the Agent Index, every 5 minutes.
#
# NO SWITCH. The reporter is here because somebody built it into this image,
# and that is the decision: an agent whose owner does not want their usage
# published is one built without this service.
#
# Baked in rather than bind-mounted: a mount whose source is missing does not
# fail, it creates a DIRECTORY at the target, and the reporter starts against
# a directory and reports nothing. Built in, the file is in the image or the
# build failed.

# Absolute, for the same reason every service's is: a service inherits the
# supervision tree's PATH, not a login shell's.
PATH=/command:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
export PATH

# Written by first boot from the credential the host dropped in, 0600 root --
# read here, before dropping to the agent's uid. AGENT_ID is which agent this
# is; without it there is nothing to report FOR, so the service stands down
# rather than guessing a name.
#
# Read with `read`, not `VAR=$(cat ...)`: plow-agents image build greps the
# build context for this variable's name immediately followed by an equals
# sign, to catch a leaked credential -- and a hit on this line, which only
# reads the value at runtime from a path no build ever sees, would make it
# refuse the build.
if [ -r /run/s6/container_environment/PLOW_AGENT_TOKEN ]; then
  IFS= read -r PLOW_AGENT_TOKEN < /run/s6/container_environment/PLOW_AGENT_TOKEN
fi
: "${PLOW_AGENT_TOKEN:=}"
AGENT_ID=$(cat /run/s6/container_environment/AGENT_ID 2>/dev/null || true)
export AGENT_ID

# Read by hand for the same reason the two above are: this service is plain
# /bin/sh, not with-contenv, so nothing the host injected reaches it otherwise.
# On a Plow cloud agent PLOW_AGENT_TOKEN is the literal placeholder `proxied`,
# which authenticates only THROUGH this proxy -- it swaps the Authorization
# header for the real credential. Miss the variable and the client falls back
# to its api.plow.co default, /v1/auth/index-identity answers 401 for `proxied`,
# and the loop below prints "no index key this pass" and sleeps. Forever, and
# quietly: the agent runs, talks, and never scores. Self-hosted the variable is
# absent and the token is real, so the client's own default is the right one.
PLOW_API_BASE=$(cat /run/s6/container_environment/PLOW_API_BASE 2>/dev/null || true)
if [ -n "$PLOW_API_BASE" ]; then
  export PLOW_API_BASE
fi

# The agent's home is where its usage store lives, and the client keeps its
# ledger beside that store. Fixed, not overridable: this image puts the home
# there, and a second way to say where it is only creates the case where the
# reporter and the agent disagree about which store is theirs.
HERMES_HOME=/var/lib/hermes
export HERMES_HOME

if [ -z "$AGENT_ID" ]; then
  echo "agent-index: no AGENT_ID in this container's environment, so there is no" >&2
  echo "agent to report for -- standing down. Set it where this container is" >&2
  echo "started (compose.yml)." >&2
  exec sleep 86400
fi

while :; do
  # The pinned client owns assertion exchange, aik_ format and atomic storage.
  # The image only invokes it; no image-owned HTTP path can hand the broad Plow
  # bearer to the Index.
  #
  # Registered already? The client owns that question:
  #   0  registered      3  not registered      2  state is there, unreadable
  # 2 is not 3, and this must not collapse them: registering over state the
  # client could not read mints against a new install id and strands the usage
  # this install has already published. That pass is skipped instead.
  /command/s6-setuidgid hermes \
    env HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" \
    /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py status >/dev/null
  case $? in
    0) ;;
    3)
      # Exported in a subshell rather than passed as `env NAME=value`, same
      # reason as above -- and the scope stays just as narrow: the export
      # never escapes the subshell, so only this one command sees it.
      (
        export PLOW_AGENT_TOKEN
        /command/s6-setuidgid hermes \
          env HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" AGENT_ID="$AGENT_ID" \
          /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py \
          --register --agent "$AGENT_ID"
      ) >/dev/null || {
      echo "agent-index: no index key this pass, not reporting" >&2
      /bin/sleep 300
      continue
      }
      ;;
    *)
      echo "agent-index: the client could not read this install's state (above);" >&2
      echo "standing off rather than registering over it." >&2
      /bin/sleep 300
      continue
      ;;
  esac

  # The client finds the key the exchange stored in the agent's home and
  # reports with that. Never fatal: a collector that failed says so and exits
  # non-zero, and a crashing longrun would be respawned in a tight loop, which
  # turns one bad pass into a hot loop against the index.
  /command/s6-setuidgid hermes \
    env HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" AGENT_ID="$AGENT_ID" \
    /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py \
    || echo "agent-index: reporter exited non-zero, see the line above" >&2
  /bin/sleep 300
done
